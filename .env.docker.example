# Copy this file to .env.docker. Never commit .env.docker.
POSTGRES_DB=kaizerstays_dev
POSTGRES_USER=kaizerstays
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql://kaizerstays:replace-with-a-long-random-local-password@postgres:5432/kaizerstays_dev?schema=public

# Safe local fallbacks. Replace only when intentionally testing Supabase auth.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KaizerStays Development

# Optional integrations. Leave blank unless you are intentionally testing them.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
KAIZER_OTA_INBOX_TOKEN=
KAIZER_CHANNEL_MANAGER_BRIDGE_URL=
KAIZER_CHANNEL_MANAGER_BRIDGE_TOKEN=
